    "id": "n6-01-orin",
    "night": 6,
    "resident": "orin",
    "truth": "peaceful",
    "anomalies": [
      "temperature"
    ],
    "title": "The one who tells you",
    "opening": "Orin places both hands where you can see them. “Before you read the card: I returned in the rain. I do not think I am the person whose name is on it.”",
    "nodes": [
      {
        "id": "where",
        "q": "Where have you been?",
        "a": "The roof garden. I left Ruth an orange. It was sour again. I wanted to be able to say I had improved at something before coming here.",
        "mood": "guarded"
      },
      {
        "id": "home",
        "q": "Who is waiting for you upstairs?",
        "a": "Lives alone; Ruth is a close friend. I do not think a memory becomes less kind because it was borrowed.",
        "mood": "neutral"
      },
      {
        "id": "detail",
        "q": "Are you saying you are a Reproduction?",
        "a": "Yes. I know that word has a button on your desk. I have never taken anyone into the rain. I have grown food, repaired windows and avoided this conversation for five years. You should verify all three claims.",
        "mood": "uneasy"
      },
      {
        "id": "follow",
        "q": "What would supervised entry mean to you?",
        "a": "People knowing what I am. People being able to ask me questions. Not a photograph used to turn me into a better version of somebody who died. I would accept observation. I would not accept being rewritten.",
        "requires": [
          "detail"
        ],
        "mood": "guarded"
      },
      {
        "id": "gentle",
        "q": "Take a breath. What do you need me to understand?",
        "a": "I need you to ask whether I agree before you decide what I should become.",
        "tone": "gentle",
        "group": "approach",
        "mood": "open"
      },
      {
        "id": "press",
        "q": "I need an explanation, not a rehearsed answer.",
        "a": "The visitor looks at the recorder before answering. “Then turn that off before you ask me to trust you.”",
        "tone": "press",
        "group": "approach",
        "mood": "defensive"
      }
    ],
    "archive": "Kitchen and garden logs corroborate five years without disappearances or violence. High phase reading predates tonight. Demister log explains dry glass but not the scanner; the visitor openly discloses being a return.",
    "call": "Ruth: “I knew before I knew the word. He stayed when my husband died. I am not asking you to call him human. I am asking what the word is supposed to decide.”",
    "hold": "A second paper arrives from the outer desk. Kitchen and garden logs corroborate five years without disappearances or violence. High phase reading predates tonight. Demister log explains dry glass but not the scanner; the visitor openly discloses being a return.",
    "disposition": "ordinary",
    "event": "",
    "evidence": "consent",
    "evidenceLabel": "Orin’s voluntary testimony",
    "evidenceText": "Orin discloses being a return and accepts observation, not compulsory rewriting. Ruth’s five-year kitchen record corroborates his conduct.",
    "memoryKey": "",
    "memoryText": "",
    "resolution": "Orin is a disclosed, independently corroborated non-hostile Echo. Voluntary supervised admission is possible; containment would harm a cooperative person.",
    "onAdmitFlag": "consent-accepted",
