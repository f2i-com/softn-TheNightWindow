    "resident": "victor",
    "truth": "human",
    "anomalies": [
      "wrong-authority"
    ],
    "title": "Executive convenience",
    "opening": "The administrator does not offer his documents. He places them on the tray as though returning something you had borrowed without asking.",
    "nodes": [
      {
        "id": "where",
        "q": "Where have you been?",
